# ---- Builder ----
FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

# Copy module files and source, generate go.sum
COPY go.mod ./
COPY . .
RUN go mod tidy

# Build the ingestion binary with static linking
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/ingestion ./cmd/ingestion

# ---- Final image ----
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 65534 nogroup && \
    adduser -u 65534 -G nogroup -D -H nobody 2>/dev/null || true

COPY --from=builder /out/ingestion /usr/local/bin/ingestion
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

USER 65534

# Default: run a delta ingestion pass. Override --mode and --country as needed.
CMD ["/usr/local/bin/ingestion", "--mode=delta", "--country=US"]
